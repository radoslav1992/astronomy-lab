---
import '../styles/global.css';
const {title='Interactive Astronomy Tools & Space Simulations',description='Explore planets, Moon phases, orbits, stars, and deep space with free interactive astronomy simulations, visual calculators, and guided lessons.',section='Explore'}=Astro.props;
const canonical=Astro.site?new URL(Astro.url.pathname,Astro.site):null;
const nav=[['Explore','/'],['Labs','/labs/'],['Planets','/planets/'],['Library','/library/'],['Learn','/learn/'],['Practice','/practice/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#060c18"/><title>{title} | Astronomy Lab</title><meta name="description" content={description}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={`${title} | Astronomy Lab`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:'Astronomy Lab',...(Astro.site?{url:Astro.site.href}:{}),description,applicationCategory:'EducationalApplication',operatingSystem:'Any',isAccessibleForFree:true})}/></head><body><a class="skip" href="#main">Skip to content</a><header class="header"><a class="brand" href="/" aria-label="Astronomy Lab home"><img src="/favicon.svg" width="39" height="39" alt=""/><span>astronomy<span class="muted">lab</span></span></a><nav aria-label="Main navigation">{nav.map(([name,url])=><a href={url} aria-current={section===name?'page':undefined}>{name}</a>)}</nav><a href="/labs/moon-phases/" class="header-link">Meet the Moon <span aria-hidden="true">↗</span></a></header><main id="main"><slot/></main><footer><div class="footer-top"><a href="/" class="brand"><img src="/favicon.svg" width="32" height="32" alt=""/>astronomylab</a><p>Stay curious. Look a little further.</p></div><div class="footer-bottom"><span>A universe of ideas. Free to explore.</span><div><a href="/formulas/">Formula reference</a><a href="/about/">About & image credits</a><a href="https://geometrylab.net">Geometry Lab ↗</a></div></div></footer></body></html>
