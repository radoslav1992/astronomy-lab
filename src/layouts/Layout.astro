---
import '../styles/global.css';
import {learningApps,currentApp} from '../lib/learning-apps.mjs';import AdSlot from '../components/AdSlot.astro';
const sisterApps=learningApps.filter(app=>app.id!==currentApp&&app.url);
const {title='The Astronomy Lab: Free Astronomy Simulations & Calculators',description='The Astronomy Lab: free interactive astronomy simulations, calculators and planet facts — orbits, Moon phases, telescopes, black holes and more. No sign-up.',section='Explore',crumbs=[],ads=true}=Astro.props;
const canonical=Astro.site?new URL(Astro.url.pathname,Astro.site):null;
const fullTitle=title.includes('Astronomy Lab')?title:`${title} | Astronomy Lab`;
// crumbs: [[name, path?], ...] after Home; the last crumb is the current page.
const breadcrumb=crumbs.length&&canonical?{'@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[['Home','/'],...crumbs].map(([name,path],i)=>({'@type':'ListItem',position:i+1,name,item:path?new URL(path,Astro.site).href:canonical.href}))}:null;
const website=Astro.url.pathname==='/'&&Astro.site?{'@context':'https://schema.org','@type':'WebSite',name:'The Astronomy Lab',alternateName:'Astronomy Lab',url:Astro.site.href,description,inLanguage:'en'}:null;
const nav=[['Explore','/'],['Labs','/labs/'],['Planets','/planets/'],['Library','/library/'],['Learn','/learn/'],['Practice','/practice/']];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><meta name="theme-color" content="#060c18"/><title>{fullTitle}</title><meta name="description" content={description}/>{canonical&&<link rel="canonical" href={canonical}/>}<meta property="og:title" content={fullTitle}/><meta property="og:site_name" content="The Astronomy Lab"/><meta property="og:description" content={description}/><meta property="og:type" content="website"/>{canonical&&<meta property="og:url" content={canonical}/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/><script type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@type':'WebApplication',name:'Astronomy Lab',...(Astro.site?{url:Astro.site.href}:{}),description,applicationCategory:'EducationalApplication',operatingSystem:'Any',isAccessibleForFree:true})}/>{breadcrumb&&<script type="application/ld+json" set:html={JSON.stringify(breadcrumb)}/>}{website&&<script type="application/ld+json" set:html={JSON.stringify(website)}/>}
<!-- Google tag (gtag.js) -->
<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-JB1EBJHB4W"></script>
<script is:inline>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());

  gtag('config', 'G-JB1EBJHB4W');
</script>
</head><body><a class="skip" href="#main">Skip to content</a><header class="header"><a class="brand" href="/" aria-label="Astronomy Lab home"><img src="/favicon.svg" width="39" height="39" alt=""/><span>astronomy<span class="muted">lab</span></span></a><nav aria-label="Main navigation">{nav.map(([name,url])=><a href={url} aria-current={section===name?'page':undefined}>{name}</a>)}</nav><a href="/labs/moon-phases/" class="header-link">Meet the Moon <span aria-hidden="true">↗</span></a></header><main id="main"><slot/></main>{ads&&<AdSlot type="leaderboard"/>}<footer><div class="footer-top"><a href="/" class="brand"><img src="/favicon.svg" width="32" height="32" alt=""/>astronomylab</a><p>Stay curious. Look a little further.</p></div><div class="footer-bottom"><span>A universe of ideas. Free to explore.</span><div><a href="/planets/compare/">Compare the planets</a><a href="/formulas/">Formula reference</a><a href="/about/">About & image credits</a><a href="/privacy/">Privacy policy</a><a href="mailto:info@theastronomylab.com">info@theastronomylab.com</a><a href="/#learning-apps">Explore our learning apps</a></div></div><nav class="footer-apps" aria-label="More free learning apps"><strong>More free learning apps</strong>{sisterApps.map(app=><a href={app.url+'/'}>{app.name}</a>)}</nav></footer></body></html>
