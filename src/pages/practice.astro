---
import Layout from '../layouts/Layout.astro';
import {questions} from '../lib/questions.mjs';
// Server-rendered so the page says what the quiz holds before any script runs: the topics with their
// question counts, and the first two questions of each topic with their answers and explanations.
const topicNames=[...new Set(questions.map(q=>q[4]))];
const counts=topicNames.map(name=>[name,questions.filter(q=>q[4]===name).length]);
const samples=topicNames.flatMap(name=>questions.filter(q=>q[4]===name).slice(0,2));
---
<Layout title="Astronomy Quiz: Practice Space & Planet Science" description="Free astronomy quiz: 36 practice questions on planets, Moon phases, seasons, eclipses, orbits, stars and telescopes, with instant feedback and explanations." section="Practice" crumbs={[['Practice']]}><div class="wrap"><div class="page-intro"><span class="eyebrow">Mission: a little more understanding</span><h1>Test your cosmic intuition.</h1><p>Up to eight questions per round, with an explanation after every answer. Choose a topic or explore the whole universe.</p></div><div class="quiz"><div class="filter-bar"><label for="quiz-topic">Your topic</label><select id="quiz-topic"><option value="">The whole universe</option><option>Solar system</option><option>Deep space</option><option>Stars</option><option>Observing</option></select><button class="btn small" id="restart">New round</button></div><div class="quiz-meta"><span id="position"></span><span id="score"></span></div><div class="progress" aria-hidden="true"><span id="progress"></span></div><div id="question-area"><h2 id="question" tabindex="-1"></h2><div class="answers" id="answers"></div><div class="quiz-feedback" id="feedback" aria-live="polite"></div><button class="btn primary" id="next" hidden>Next question →</button></div></div><noscript><p>Enable JavaScript to take the quiz. You can still explore all <a href="/learn/">field notes</a>.</p></noscript>
<section class="section quiz-notes"><h2>What the astronomy quiz covers</h2><p>The quiz draws from {questions.length} multiple-choice questions in {counts.length} topics: {counts.map(([name,n],i)=><>{i>0&&(i===counts.length-1?' and ':', ')}{name} ({n})</>)}. Each round picks up to eight at random, so a second round on the same topic brings new questions. After every answer you see which choice was right and a short explanation of why. There is no timer and nothing to sign up for.</p>
<h2>Sample questions and answers</h2><ol class="quiz-samples">{samples.map(q=><li><h3>{q[0]}</h3><p><strong>Answer:</strong> {q[1][q[2]]}. {q[3]}</p></li>)}</ol>
<p>To go deeper into a topic, read the <a class="text-link" href="/learn/">visual guides</a> or try one of the <a class="text-link" href="/labs/">simulations and calculators</a>. Teachers can find printable worksheets and answer keys on the <a class="text-link" href="/teachers/">teacher page</a>.</p></section></div></Layout>
<script>
import {questions} from '../lib/questions.mjs';
const topic=document.querySelector('#quiz-topic') as HTMLSelectElement,q=document.querySelector('#question') as HTMLElement,answers=document.querySelector('#answers')!,feedback=document.querySelector('#feedback')!,next=document.querySelector('#next') as HTMLButtonElement;
let round:any[]=[],index=0,score=0,answered=false;
function draw(focus=false){answered=false;next.hidden=true;feedback.textContent='';document.querySelector('#position')!.textContent=`Question ${index+1} of ${round.length}`;document.querySelector('#score')!.textContent=`${score} correct`;(document.querySelector('#progress') as HTMLElement).style.width=`${index/round.length*100}%`;q.textContent=round[index][0];answers.replaceChildren();round[index][1].forEach((answer:string,i:number)=>{const b=document.createElement('button');b.className='btn';b.textContent=answer;b.addEventListener('click',()=>choose(i));answers.append(b);});if(focus)q.focus();}
function start(focus=false){const pool=questions.filter(q=>!topic.value||q[4]===topic.value);for(let i=pool.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[pool[i],pool[j]]=[pool[j],pool[i]];}round=pool.slice(0,8);index=0;score=0;draw(focus);}
function choose(i:number){if(answered)return;answered=true;const correct=round[index][2];if(i===correct)score++;Array.from(answers.children).forEach((el:any,j)=>{el.disabled=true;if(j===correct)el.classList.add('correct');else if(j===i)el.classList.add('wrong');});feedback.replaceChildren();const title=document.createElement('strong'),p=document.createElement('p');title.textContent=i===correct?'That’s right.':'A useful discovery.';p.textContent=round[index][3];feedback.append(title,p);document.querySelector('#score')!.textContent=`${score} correct`;next.hidden=false;next.textContent=index===round.length-1?'See your results →':'Next question →';}
next.addEventListener('click',()=>{if(!answered)return;index++;if(index<round.length){draw(true);return;}next.hidden=true;answers.replaceChildren();q.textContent=`You got ${score} of ${round.length}.`;feedback.textContent=score===round.length?'A stellar round. Try a new topic or head into a lab to keep exploring.':'Every question is another way in. Explore a lab, then come back for another round.';document.querySelector('#position')!.textContent='Round complete';(document.querySelector('#progress') as HTMLElement).style.width='100%';q.focus();});document.querySelector('#restart')!.addEventListener('click',()=>start(true));topic.addEventListener('change',()=>start(true));start();
</script>
