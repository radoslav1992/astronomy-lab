---
import RelatedLearning from '../../components/RelatedLearning.astro';
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import {labs} from '../../lib/labs.mjs';import {render} from '../../lib/render.mjs';
export function getStaticPaths(){return labs.map(lab=>({params:{slug:lab.id},props:{lab}}));}const {lab}=Astro.props;const result=render(lab.id,Object.fromEntries(lab.fields.map(f=>[f.id,f.value])));
---
<Layout title={`${lab.name} Explained — Astronomy Guide`} description={lab.description} section="Learn"><article class="reading"><div class="breadcrumb"><a href="/learn/">Field notes</a> / {lab.category}</div><div class="page-intro"><span class="eyebrow">{lab.lead}</span><h1>Understanding {lab.name.toLowerCase()}</h1><p>{lab.description}</p></div><div class="viz" set:html={result.svg}/><h2>The idea behind it</h2><p>{lab.explain}</p><h2>The relationship to remember</h2><div class="formula">{lab.formula}</div><p>{result.worked}</p><h2>Make your own discovery</h2><p>{lab.try}</p><a class="btn primary" href={`/labs/${lab.id}/`}>Try the interactive lab ↗</a><h2>What this model leaves out</h2><p>{lab.assumption}</p><Faq title="Check your understanding" items={lab.qa}/><p class="worked">Continue with the <a href="/formulas/">formula reference</a> or test yourself in <a href="/practice/">space practice</a>.</p><RelatedLearning topic={lab.id}/></article></Layout>
