---
import RelatedLearning from '../../components/RelatedLearning.astro';
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import {labs} from '../../lib/labs.mjs';import {render} from '../../lib/render.mjs';import LabReference from '../../components/LabReference.astro';import SchwarzschildCalculator from '../../components/SchwarzschildCalculator.astro';import AdSlot from '../../components/AdSlot.astro';import ClassroomShare from '../../components/ClassroomShare.astro';
export function getStaticPaths(){return labs.map(lab=>({params:{slug:lab.id},props:{lab}}));}const {lab}=Astro.props;const result=render(lab.id,Object.fromEntries(lab.fields.map(f=>[f.id,f.value])));const url=new URL(`/learn/${lab.id}/`,Astro.site).href;
---
<Layout title={lab.learnTitle} description={lab.learnSummary} section="Learn" crumbs={[['Learn','/learn/'],[lab.learnTitle]]}><article class="reading"><div class="breadcrumb"><a href="/learn/">Field notes</a> / {lab.category}</div><div class="page-intro"><span class="eyebrow">{lab.lead}</span><h1>{lab.learnTitle}</h1><p>{lab.learnSummary}</p><div class="page-actions"><ClassroomShare url={url}/><a class="btn small" href={`/labs/${lab.id}/activity/`}>Classroom activity <span aria-hidden="true">↗</span></a></div></div>{lab.id==='black-hole-radius'&&<SchwarzschildCalculator/>}<div class="viz" set:html={result.svg}/><h2>The idea behind it</h2><p>{lab.explain}</p><h2>The relationship to remember</h2><div class="formula">{lab.formula}</div><p>{result.worked}</p><AdSlot type="rectangle"/><h2>Make your own discovery</h2><p>{lab.try}</p><a class="btn primary" href={`/labs/${lab.id}/`}>Open the {lab.title} ↗</a><LabReference lab={lab}/><h2>What this model leaves out</h2><p>{lab.assumption}</p><AdSlot type="native"/><Faq title="Check your understanding" items={lab.qa}/><p class="worked">Continue with the <a href="/formulas/">formula reference</a> or test yourself in <a href="/practice/">space practice</a>.</p><RelatedLearning topic={lab.id}/></article></Layout>
