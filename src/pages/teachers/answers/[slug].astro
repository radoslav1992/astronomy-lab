---
import Layout from '../../../layouts/Layout.astro';import ActivityTable from '../../../components/ActivityTable.astro';import {labs} from '../../../lib/labs.mjs';import {activities,standards} from '../../../lib/activities.mjs';
export function getStaticPaths(){return activities.map(act=>({params:{slug:act.lab},props:{act,lab:labs.find(l=>l.id===act.lab)}}));}
const {act,lab}=Astro.props;
---
<Layout title={`Answer Key: ${act.title}`} description={`Teacher answer key for the ${act.title.toLowerCase()}: completed results table and worked answers, calculated with the same model as the lab.`} section="Labs" ads={false} noindex crumbs={[['Teachers','/teachers/'],[`Answer key: ${lab.name}`]]}><article class="worksheet answer-key"><div class="breadcrumb no-print"><a href="/teachers/">For teachers</a> / Answer key</div><header class="worksheet-head"><div><span class="eyebrow">Teacher answer key · {act.grade} · about {act.minutes} minutes</span><h1>Answer key: {act.title}</h1></div></header><p class="key-note no-print">For teachers. This page is hidden from search engines and not linked from student pages, but it is not password-protected, so please don’t share the link with students. Student worksheet: <a href={`/labs/${lab.id}/activity/`}>{act.title}</a>.</p><p class="worksheet-goal"><strong>Goal:</strong> {act.goal}</p>{act.standards.length>0&&<p class="worksheet-meta">Connects to NGSS {act.standards.map(code=>`${code} (${standards[code]})`).join('; ')}</p>}<h2>Completed results table</h2><p class="worksheet-meta">Values are the lab’s own readouts for each setting.</p><ActivityTable act={act} lab={lab} answers/><h2>Answers</h2><ol class="questions key-answers">{act.questions.map(q=><li><p class="key-question">{q.q}</p><p>{q.a}</p></li>)}</ol><div class="page-actions no-print"><button class="btn primary" type="button" data-print>Print answer key</button><a class="btn" href="/teachers/">All activities</a></div></article></Layout>
<script>document.querySelector('[data-print]')?.addEventListener('click',()=>print());</script>
