---
import Layout from '../../layouts/Layout.astro';import Experiment from '../../components/Experiment.astro';import Faq from '../../components/Faq.astro';import LabCard from '../../components/LabCard.astro';import LabReference from '../../components/LabReference.astro';import AdSlot from '../../components/AdSlot.astro';import ClassroomShare from '../../components/ClassroomShare.astro';import {labs} from '../../lib/labs.mjs';
export function getStaticPaths(){return labs.map(lab=>({params:{slug:lab.id},props:{lab}}));}const {lab}=Astro.props;const url=new URL(`/labs/${lab.id}/`,Astro.site).href;
---
<Layout title={lab.title} description={lab.summary} section="Labs" crumbs={[['Labs','/labs/'],[lab.name]]}><div class="wrap"><div class="breadcrumb"><a href="/labs/">All experiments</a> / {lab.category}</div><div class="page-intro"><span class="eyebrow">{lab.lead}</span><h1>{lab.name}</h1><p>{lab.summary}</p><div class="page-actions"><ClassroomShare url={url}/><a class="btn small" href={`/labs/${lab.id}/activity/`}>Classroom activity <span aria-hidden="true">↗</span></a><a class="text-link" href="/teachers/">Teaching with this lab?</a></div></div><Experiment lab={lab}/><AdSlot type="rectangle"/><div class="explanation"><div><h2>How it works</h2><div class="formula">{lab.formula}</div><p>{lab.explain}</p><a class="text-link" href={`/learn/${lab.id}/`}>{lab.learnTitle} ↗</a></div><div><aside class="note"><h3>Try this</h3><p>{lab.try}</p></aside><p class="worked"><strong>About this model</strong><br/>{lab.assumption}</p></div></div><LabReference lab={lab}/><AdSlot type="native"/><Faq title={`${lab.name}: common questions`} items={lab.qa}/><section class="section"><h2>Your next discovery</h2><div class="lab-grid">{labs.filter(l=>l.id!==lab.id).sort((a,b)=>Number(b.category===lab.category)-Number(a.category===lab.category)).slice(0,3).map(l=><LabCard lab={l}/>)}</div></section></div></Layout>
