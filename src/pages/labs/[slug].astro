---
import Layout from '../../layouts/Layout.astro';import Experiment from '../../components/Experiment.astro';import Faq from '../../components/Faq.astro';import LabCard from '../../components/LabCard.astro';import {labs} from '../../lib/labs.mjs';
export function getStaticPaths(){return labs.map(lab=>({params:{slug:lab.id},props:{lab}}));}const {lab}=Astro.props;
---
<Layout title={lab.name+' — Interactive Astronomy Tool'} description={lab.description} section="Labs"><div class="wrap"><div class="breadcrumb"><a href="/labs/">All experiments</a> / {lab.category}</div><div class="page-intro"><span class="eyebrow">{lab.lead}</span><h1>{lab.name}</h1><p>{lab.description}</p></div><Experiment lab={lab}/><div class="explanation"><div><h2>How it works</h2><div class="formula">{lab.formula}</div><p>{lab.explain}</p><a class="text-link" href={`/learn/${lab.id}/`}>Read the field note ↗</a></div><div><aside class="note"><h3>Try this</h3><p>{lab.try}</p></aside><p class="worked"><strong>About this model</strong><br/>{lab.assumption}</p></div></div><Faq title={`${lab.name}: common questions`} items={lab.qa}/><section class="section"><h2>Your next discovery</h2><div class="lab-grid">{labs.filter(l=>l.id!==lab.id).sort((a,b)=>Number(b.category===lab.category)-Number(a.category===lab.category)).slice(0,3).map(l=><LabCard lab={l}/>)}</div></section></div></Layout>
