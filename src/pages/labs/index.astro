---
import Layout from '../../layouts/Layout.astro';import LabCard from '../../components/LabCard.astro';import AdSlot from '../../components/AdSlot.astro';import {labs} from '../../lib/labs.mjs';
---
<Layout title="Astronomy Simulations, Virtual Labs & Calculators" description={`${labs.length} free astronomy simulations, virtual labs and calculators: orbit simulator, Moon phases, seasons, eclipses, telescope simulator, exoplanet transits and more.`} section="Labs" crumbs={[['Labs']]}><div class="wrap"><div class="page-intro"><span class="eyebrow">Big questions. Hands-on answers.</span><h1>{labs.length} free astronomy simulations and virtual labs</h1><p>Interactive astronomy simulations, virtual labs and calculators that run in your browser: an orbit simulator, Moon phases, seasons and eclipse simulators, a telescope simulator and calculator, exoplanet transits and more. Pick an experiment and start changing the numbers — no sign-up, no download. Each lab has a short lesson and a printable classroom activity.</p></div><div class="filter-bar"><input type="search" id="search" aria-label="Search astronomy labs" placeholder="Search orbits, eclipses, telescopes…"/><select id="category" aria-label="Filter by topic"><option value="">Every corner of space</option>{[...new Set(labs.map(l=>l.category))].map(c=><option>{c}</option>)}</select></div><p class="catalog-count" id="count" aria-live="polite">{labs.length} experiments to explore</p><div class="lab-grid">{labs.map((lab,i)=><><LabCard lab={lab}/>{i===5&&<div class="grid-ad" data-grid-ad><AdSlot type="rectangle"/></div>}</>)}</div><p id="empty" hidden>No experiments match that search. Try “Moon” or choose another topic.</p><aside class="teacher-callout"><div><span class="eyebrow">For teachers</span><h2>Teaching with these labs?</h2><p>Every lab has a free printable student activity and an answer key, and a Share to Google Classroom button. Students need no accounts.</p></div><a class="btn primary" href="/teachers/">Classroom activities <span aria-hidden="true">↗</span></a></aside></div></Layout>
<script>
const search=document.querySelector('#search') as HTMLInputElement,category=document.querySelector('#category') as HTMLSelectElement;
function filter(){let count=0;document.querySelectorAll<HTMLElement>('.lab-card').forEach(el=>{const show=el.dataset.search!.includes(search.value.trim().toLowerCase())&&(!category.value||el.dataset.category===category.value);el.hidden=!show;if(show)count++;});document.querySelector('#count')!.textContent=`${count} experiment${count===1?'':'s'} to explore`;(document.querySelector('#empty') as HTMLElement).hidden=count!==0;const ad=document.querySelector<HTMLElement>('[data-grid-ad]');if(ad)ad.hidden=!!(search.value.trim()||category.value);}search.addEventListener('input',filter);category.addEventListener('change',filter);
</script>
