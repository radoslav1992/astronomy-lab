---
import Layout from '../../../layouts/Layout.astro';import ActivityTable from '../../../components/ActivityTable.astro';import ClassroomShare from '../../../components/ClassroomShare.astro';import {labs} from '../../../lib/labs.mjs';import {activities,standards} from '../../../lib/activities.mjs';
export function getStaticPaths(){return activities.map(act=>({params:{slug:act.lab},props:{act,lab:labs.find(l=>l.id===act.lab)}}));}
const {act,lab}=Astro.props;const url=new URL(`/labs/${lab.id}/activity/`,Astro.site).href;
const description=`Free printable ${act.title.toLowerCase()} for ${act.grade.toLowerCase()}, about ${act.minutes} minutes with the interactive ${lab.name.toLowerCase()} lab. No sign-up; answer key for teachers.`;
const resource={'@context':'https://schema.org','@type':'LearningResource',name:act.title,description:act.goal,url,learningResourceType:'Worksheet',educationalLevel:act.grade,timeRequired:`PT${act.minutes}M`,isAccessibleForFree:true,inLanguage:'en',...(act.standards.length?{educationalAlignment:act.standards.map(code=>({'@type':'AlignmentObject',alignmentType:'educationalSubject',educationalFramework:'Next Generation Science Standards',targetName:code}))}:{})};
---
<Layout title={`${act.title}: Free Student Activity`} description={description} section="Labs" crumbs={[['Labs','/labs/'],[lab.name,`/labs/${lab.id}/`],['Classroom activity']]}><article class="worksheet"><div class="breadcrumb no-print"><a href={`/labs/${lab.id}/`}>{lab.name}</a> / Classroom activity</div><header class="worksheet-head"><div><span class="eyebrow">Student activity · {act.grade} · about {act.minutes} minutes</span><h1>{act.title}</h1></div><div class="name-lines" aria-hidden="true"><span>Name</span><span>Class</span><span>Date</span></div></header><p class="worksheet-goal"><strong>Goal:</strong> {act.goal}</p><p class="worksheet-meta">Open the lab at <strong>theastronomylab.com/labs/{lab.id}/</strong>{act.standards.length>0&&<span> · Connects to NGSS {act.standards.join(', ')}</span>}</p><div class="page-actions no-print"><button class="btn primary" type="button" data-print>Print worksheet</button><a class="btn" href={`/labs/${lab.id}/`}>Open the lab <span aria-hidden="true">↗</span></a><ClassroomShare url={url}/></div><h2>What to do</h2><ol class="steps">{act.steps.map(step=><li>{step}</li>)}</ol><h2>Record your results</h2><ActivityTable act={act} lab={lab}/><h2>Questions</h2><ol class="questions">{act.questions.map(q=><li><p>{q.q}</p><div class="write-lines" aria-hidden="true">{Array.from({length:q.lines},()=><span/>)}</div></li>)}</ol><p class="worksheet-foot">Free from The Astronomy Lab · theastronomylab.com{act.standards.length>0&&<span class="no-print"> · {act.standards.map(code=>`${code}: ${standards[code]}`).join(' ')}</span>}</p></article><script type="application/ld+json" set:html={JSON.stringify(resource)}/></Layout>
<script>document.querySelector('[data-print]')?.addEventListener('click',()=>print());</script>
