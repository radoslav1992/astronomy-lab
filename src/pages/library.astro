---
import Layout from '../layouts/Layout.astro';
import '../styles/library.css';
const topics=[['Nebulae','nebula'],['Galaxies','galaxy'],['The Moon','moon'],['Mars','mars'],['Earth','earth'],['Saturn','saturn'],['Stars','stars'],['Apollo','apollo']];
---
<Layout title="NASA Space Image Library — Explore Planets, Stars & Galaxies" description="Search NASA’s image archive for planets, galaxies, nebulae, and space missions. View photographs, read their stories, and open original NASA image files." section="Library">
<div class="wrap library-page"><div class="library-intro"><div><span class="eyebrow">The universe, in pictures</span><h1>NASA space image library</h1><p>Real worlds. Distant galaxies. Moments that changed how we see our place in space. Find a photograph and follow its story.</p></div><img src="/images/cosmic-cliffs.webp" alt="Webb infrared view of the Cosmic Cliffs" width="1280" height="741"/><span class="library-intro-credit">NASA, ESA, CSA, STScI</span></div>
<form id="library-search" class="library-search" role="search"><label class="sr-only" for="library-query">Search NASA images</label><input id="library-query" name="q" type="search" maxlength="160" placeholder="Try Orion Nebula, Saturn, Apollo 11…" value="nebula" required/><button type="submit" class="btn primary">Search images <span aria-hidden="true">↗</span></button></form>
<div class="library-topics" aria-label="Image topics">{topics.map(([label,q])=><button type="button" class="btn small" data-topic={q} aria-pressed={q==='nebula'}>{label}</button>)}</div>
<div class="library-results-heading"><h2 id="library-heading" tabindex="-1">Explore NASA’s image archive</h2><p id="library-status" role="status" aria-live="polite">Loading images from NASA…</p></div>
<div id="library-notice" class="library-notice" hidden><p id="library-message"></p><button id="library-retry" class="btn small" type="button">Try again</button></div>
<div id="library-grid" class="library-grid" aria-busy="true" aria-label="NASA image search results"></div>
<nav class="library-pagination" aria-label="Image result pages" hidden><button type="button" class="btn" id="library-prev">← Previous</button><span id="library-page-label"></span><button type="button" class="btn" id="library-next">Next →</button></nav>
<noscript><div class="note"><h2>Explore the archive</h2><p>Enable JavaScript to search NASA’s archive here, or visit the <a class="text-link" href="https://images.nasa.gov/">NASA Image and Video Library</a>. Our <a class="text-link" href="/planets/">planet atlas</a> is available without JavaScript.</p></div></noscript>
<aside class="library-attribution"><h2>Behind the images</h2><p>Search results and descriptions come directly from NASA’s Image and Video Library. The archive includes photographs, illustrations, and processed scientific images. Credits and reuse conditions can vary by asset; check the full description and original source before reusing an image.</p><div class="actions"><a class="text-link" href="https://images.nasa.gov/">Visit NASA’s library ↗</a><a class="text-link" href="https://www.nasa.gov/nasa-brand-center/images-and-media/">Image use guidelines ↗</a><a class="text-link" href="/about/#images">Our image credits ↗</a></div></aside></div>
<dialog id="image-dialog" class="image-dialog" aria-labelledby="image-title"><div class="image-dialog-top"><span>NASA / IMAGE ARCHIVE</span><button type="button" class="btn small" id="image-close" autofocus>Close ✕</button></div><div class="image-dialog-grid"><div class="image-preview-wrap"><img id="image-preview" alt=""/><p id="image-error" hidden>The image preview couldn’t load. You can still read the details and open the source.</p></div><div class="image-details"><span class="eyebrow" id="image-date"></span><h2 id="image-title"></h2><p class="image-credit" id="image-credit"></p><p id="image-description"></p><div class="image-keywords" id="image-keywords"></div><div class="actions"><a class="btn primary" id="image-original" target="_blank" rel="noopener noreferrer" hidden>Open original image ↗</a><a class="btn" id="image-source" target="_blank" rel="noopener noreferrer">View on NASA ↗</a></div><p class="worked" id="image-asset-status" role="status"></p><p class="worked">Original files may be large. Check the source credit and NASA’s media guidelines before reuse.</p></div></div></dialog>
</Layout>
<script src="../scripts/library.ts"></script>
