---
import Layout from '../layouts/Layout.astro';import Faq from '../components/Faq.astro';import LabCard from '../components/LabCard.astro';import {planets} from '../lib/planets.mjs';import {labs} from '../lib/labs.mjs';
const p=planets[5];
---
<Layout><section class="hero"><div class="hero-grid"><div class="hero-copy"><span class="eyebrow">Your window to the universe</span><h1>Explore astronomy.<br/><em>Feel the wonder.</em></h1><p>Play with orbits. Chase a beam of light. Get to know the worlds beyond our own.</p><div class="actions"><a class="btn primary" href="/labs/">Enter the lab <span aria-hidden="true">↗</span></a><a class="text-link" href="/labs/moon-phases/">Explore Moon phases</a></div></div><div class="hero-planet" aria-live="polite"><div class="reticle"></div><img id="hero-image" src="/images/saturn.webp" alt="Saturn and its rings photographed by Cassini" width="1024" height="341" fetchpriority="high"/><div class="planet-caption"><div><span id="hero-number">06 / GAS GIANT</span><strong id="hero-name">Saturn</strong></div><div><span>Distance from the Sun</span><strong id="hero-distance">9.57 AU</strong></div><a class="text-link" id="hero-link" href="/planets/saturn/" aria-label="Explore Saturn">Explore ↗</a></div></div></div><div class="planet-strip" aria-label="Choose a planet">{planets.map((planet,i)=><button class="planet-pick" data-planet={planet.id} aria-pressed={planet.id===p.id}><span class="orb" style={`--planet:${planet.color}`} aria-hidden="true"></span>{planet.name}</button>)}</div><p class="hero-note">Eight worlds. Choose one to begin. Images: NASA and mission partners · <a href="/about/#images">Credits</a></p></section>
<div class="wrap"><section class="section"><div class="section-head"><div><span class="eyebrow">Less memorizing. More discovering.</span><h2>Interactive astronomy labs & calculators</h2><p>Change one thing. See what happens. Make a little more sense of a very big universe.</p></div><a href="/labs/" class="text-link">All 10 experiments ↗</a></div><div class="lab-grid">{[labs[0],labs[1],labs[6],labs[3],labs[4],labs[5]].map(lab=><LabCard lab={lab}/>)}</div></section>
<section class="nebula"><img src="/images/cosmic-cliffs.webp" alt="Glittering stars above the amber gas and dust of the Cosmic Cliffs, imaged by Webb in infrared" width="1280" height="741" loading="lazy"/><div class="nebula-content"><span class="eyebrow">Go a little further</span><h2>Somewhere in this dust,<br/>a star is being born.</h2><p>The universe has a story to tell. Start with light, gravity, and a few very good questions.</p><a class="btn primary" href="/learn/">Explore the field notes ↗</a><small>Cosmic Cliffs, NGC 3324 · Webb infrared image<br/>NASA, ESA, CSA, STScI</small></div></section>
<section class="section"><div class="section-head"><div><span class="eyebrow">A small challenge</span><h2>How well do you know your universe?</h2><p>Why does the Moon change shape? Which stars burn hotter? Test your intuition, then see the explanation.</p></div><a class="btn" href="/practice/">Take a space quiz ↗</a></div></section>
<Faq title="Astronomy questions, answered" items={[["Is Astronomy Lab free?","Yes. Every experiment, planet guide, lesson, and practice question is free, with no account needed."],["Are the simulations scientifically accurate?","They use standard astronomy equations and simplified educational models. Each lab explains its assumptions. Planet positions and diagrams are not a live sky map."],["Can I use these tools in class?","Yes. Try the presets, change values together, share a link to an experiment, or download an SVG diagram for a lesson."],["Are these real space photographs?","The planet and nebula images are sourced from NASA and its mission partners. Telescope images may use processed color or map infrared wavelengths into visible colors. Interactive diagrams are explanatory illustrations."]]}/></div>
</Layout>
<script>
import {planets} from '../lib/planets.mjs';
document.querySelectorAll<HTMLButtonElement>('[data-planet]').forEach(b=>b.addEventListener('click',()=>{const p=planets.find(p=>p.id===b.dataset.planet)!;const index=planets.indexOf(p);document.querySelectorAll('[data-planet]').forEach(el=>el.setAttribute('aria-pressed',String(el===b)));const im=document.querySelector('#hero-image') as HTMLImageElement;im.src=`/images/${p.id}.webp`;im.alt=`${p.name}, photographed by NASA and mission partners`;document.querySelector('#hero-name')!.textContent=p.name;document.querySelector('#hero-number')!.textContent=`${String(index+1).padStart(2,'0')} / ${p.kind.toUpperCase()}`;document.querySelector('#hero-distance')!.textContent=(p.distance/149.5978707).toFixed(2)+' AU';const a=document.querySelector('#hero-link') as HTMLAnchorElement;a.href=`/planets/${p.id}/`;a.setAttribute('aria-label',`Explore ${p.name}`);}));
</script>
