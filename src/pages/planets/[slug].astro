---
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import {planets,byId,moon,planetFacts,num,sci,sizeDiagram} from '../../lib/planets.mjs';
export function getStaticPaths(){return planets.map(p=>({params:{slug:p.id},props:{p}}));}
const {p}=Astro.props;const earth=byId('earth');const f=planetFacts(p);const isEarth=p.id==='earth',giant=p.kind!=='Terrestrial planet',n=p.name;
const ratio=(x:number)=>num(x,x<1?3:x<10?2:1),times=(x:number)=>num(x,2),miles=(km:number)=>num(km*.621371),duration=(h:number)=>Math.abs(h)>=48?`${num(Math.abs(h)/24,1)} Earth days`:`${num(Math.abs(h),1)} hours`,minutes=(m:number)=>m>=60?`${Math.floor(m/60)} h ${Math.round(m%60)} min`:`${num(m,1)} minutes`;
const g=p.gravity.toFixed(1),weight=Math.round(100*f.gravityRatio),where=giant?'at the 1-bar level in its atmosphere':'at the surface';
const wide=f.widthRatio>=1?`${times(f.widthRatio)} times wider than Earth`:`${times(f.widthRatio)} times Earth’s width (about ${Math.round(f.widthRatio*100)}%)`;
const fit=f.volumeRatio>=1?`about ${num(f.volumeRatio)} Earths could fit inside it`:`about ${num(1/f.volumeRatio,1)} ${n}-sized worlds would fit inside Earth`;
const year=`${num(p.period,1)} Earth days (${num(f.years,2)} Earth years)`;const day=`${duration(p.day)}${Math.abs(p.day)>=48?` (${num(p.day,1)} hours)`:''}`;const spin=`${duration(p.rotation)}${f.retrograde?', retrograde':''}`;
const type={'Terrestrial planet':`No. ${n} is a terrestrial, or rocky, planet with a solid surface of rock and metal — one of the four inner planets with Mercury, Venus, Earth and Mars. The gas giants are Jupiter and Saturn.`,'Gas giant':`Yes. ${n} is a gas giant made mostly of hydrogen and helium. It has no solid surface to stand on, so its “surface” gravity and temperature refer to the 1-bar pressure level in its atmosphere. Jupiter and Saturn are the solar system’s two gas giants.`,'Ice giant':`${n} is usually called an ice giant rather than a gas giant. Like Jupiter and Saturn it has no solid surface, but more of its mass is made of “ices” — water, ammonia and methane — beneath a hydrogen–helium atmosphere. Uranus and Neptune are the two ice giants.`}[p.kind];
const typeQ=p.kind==='Terrestrial planet'?`Is ${n} a rocky planet or a gas giant?`:p.kind==='Gas giant'?`Is ${n} a gas giant?`:`Is ${n} a gas giant or an ice giant?`;
const density=`${num(p.density)} kg/m³ (${f.densityG.toFixed(2)} g/cm³)${f.densityG<1?' — less dense than water':p.id==='earth'?' — the densest planet':''}`;
const title=`${n} Facts: Size, Diameter, Gravity & Mass`;const areaMillion=f.area/1e6;
const description=isEarth?`Earth is ${num(p.diameter)} km (${miles(p.diameter)} mi) wide at the equator, with gravity of ${g} m/s², a mass of ${sci(p.mass*1e24)} kg and a mean distance of ${num(p.distance,1)} million km from the Sun.`:`${n} is ${num(p.diameter)} km (${miles(p.diameter)} mi) wide — ${times(f.widthRatio)}× Earth. Gravity ${g} m/s² (${times(f.gravityRatio)}× Earth), mass ${ratio(f.massRatio)} Earths, ${num(f.au,2)} AU from the Sun. Full facts.`;
const facts=[['Planet type',p.kind],['Equatorial diameter',`${num(p.diameter)} km (${miles(p.diameter)} mi)`],['Mean radius',`${num(p.radius,1)} km (${miles(p.radius)} mi)`],...(isEarth?[]:[['Size compared with Earth',`${times(f.widthRatio)}× as wide · ${ratio(f.volumeRatio)}× the volume`]]),['Equatorial circumference',`${num(f.circumference)} km (${miles(f.circumference)} mi)`],['Surface area',`${sci(f.area)} km²`],['Volume',`${sci(f.volume)} km³`],['Mass',`${sci(p.mass*1e24)} kg (${ratio(f.massRatio)} Earth masses)`],['Mean density',density],['Surface gravity',`${g} m/s² (${times(f.gravityRatio)}× Earth)${giant?' at 1 bar':''}`],['Escape velocity',`${p.escape} km/s`],['Length of day (solar)',day],['Rotation period (sidereal)',spin],['Orbital period (year)',year],['Mean distance from the Sun',`${num(p.distance,1)} million km (${num(f.distanceMiles,1)} million mi) · ${num(f.au,2)} AU`],['Closest and farthest from the Sun',`${num(p.perihelion,1)} – ${num(p.aphelion,1)} million km`],...(isEarth?[]:[['Distance from Earth',`${num(f.near,1)} – ${num(f.far,1)} million km`]]),['Sunlight travel time',minutes(f.lightMinutes)],['Mean orbital speed',`${p.speed} km/s`],['Axial tilt',`${p.tilt}°`],['Mean temperature',`${p.temp} °C${giant?' at 1 bar':''}`],['Known moons',String(p.moons)],['Ring system',p.rings?'Yes':'No']];
const faq=isEarth?[['How big is Earth?',`Earth is ${num(p.diameter)} km (${miles(p.diameter)} miles) wide at the equator, with a mean radius of ${num(p.radius)} km. Its equatorial circumference is about ${num(f.circumference)} km (${miles(f.circumference)} miles) and its surface area about ${num(areaMillion)} million km².`],['What is the gravity on Earth?',`Surface gravity averages about 9.8 m/s² (standard gravity is defined as 9.80665 m/s²). It is slightly weaker at the equator than at the poles because Earth spins and bulges.`],['What is Earth’s mass?',`About ${sci(p.mass*1e24)} kg. Jupiter is ${num(byId('jupiter').mass/p.mass)} times as massive, while Mars has about ${num(byId('mars').mass/p.mass,2)} of Earth’s mass.`],['How far is Earth from the Sun?',`On average ${num(p.distance,1)} million km (${num(f.distanceMiles,1)} million miles), defined as about 1 AU. Earth is closest, ${num(p.perihelion,1)} million km, in early January and farthest, ${num(p.aphelion,1)} million km, in early July. Sunlight takes about ${minutes(f.lightMinutes)} to arrive.`],['How long is a day and a year on Earth?',`A solar day lasts 24 hours, while one rotation relative to the stars takes about 23.9 hours. One orbit around the Sun takes ${num(p.period,1)} days.`],[typeQ,type],['What is Earth’s density?',`Earth’s mean density is ${density}. Its iron-nickel core makes it denser than any other planet.`]]:[[`How big is ${n} compared to Earth?`,`${n} is ${num(p.diameter)} km (${miles(p.diameter)} miles) wide at its equator, ${wide}. By volume, ${fit}, and its mass is ${ratio(f.massRatio)} times Earth’s.`],[`What is the gravity on ${n}?`,`Gravity on ${n} is about ${g} m/s² ${where}, or ${times(f.gravityRatio)} times Earth’s. Someone who weighs 100 lb on Earth would weigh about ${weight} lb there; escape velocity is ${p.escape} km/s.`],[`What is the mass of ${n}?`,`${n} has a mass of about ${sci(p.mass*1e24)} kg, or ${ratio(f.massRatio)} Earth masses. Its mean density is ${density}.`],[`How far is ${n} from Earth?`,`The distance changes as both planets orbit the Sun. ${n} comes within about ${num(f.near,1)} million km of Earth and can be as far as ${num(f.far,1)} million km away. It orbits ${num(f.au,2)} AU from the Sun on average.`],[`How long is a year on ${n}?`,`One orbit takes about ${year}. A solar day on ${n} lasts ${day}.`],[typeQ,type],[`What is the density of ${n}?`,`${n}’s mean density is ${density}. Earth’s is ${num(earth.density)} kg/m³.`]];
const figure=sizeDiagram(isEarth?[earth,moon]:[earth,p]);
---
<Layout title={title} description={description} section="Planets" crumbs={[['Planets','/planets/'],[n]]}><div class="wrap"><div class="breadcrumb"><a href="/planets/">Planet atlas</a> / {n} · <a href="/planets/compare/">Compare all planets</a></div><div class="planet-detail"><div><span class="eyebrow">{p.kind} / World 0{planets.indexOf(p)+1}</span><h1>{n}</h1><p class="planet-tag">{p.tag}</p><p class="answer"><strong>{isEarth?'How big is Earth?':`How big is ${n}?`}</strong> {isEarth?`Earth is ${num(p.diameter)} km (${miles(p.diameter)} miles) across at the equator, the largest of the four rocky planets. Its surface gravity is ${g} m/s² and it orbits the Sun at an average ${num(p.distance,1)} million km (1 AU).`:`${n} is ${num(p.diameter)} km (${miles(p.diameter)} miles) across at its equator — ${wide} — and ${fit}. Gravity ${where} is ${g} m/s², ${times(f.gravityRatio)} times Earth’s.`}</p><p>{p.description}</p><div class="actions"><a class="btn" href={`/labs/orbit-simulator/?a=${(p.distance/149.5978707).toFixed(3)}&e=${p.e}&mass=1&phase=0`}>Explore this orbit ↗</a><a class="text-link" href="/planets/compare/">Compare all eight planets</a></div></div><img src={`/images/${p.id}.webp`} alt={`${n}, NASA and mission partners`} width="1024" height={p.id === 'saturn' ? 341 : 576}/></div><p class="worked">Image: {p.credit}. Processed mission imagery; apparent color varies with filters and processing.</p>
<div class="stats-grid"><div class="stat"><span>Equatorial diameter</span><strong>{num(p.diameter)} km</strong></div><div class="stat"><span>Surface gravity</span><strong>{g} m/s²</strong></div><div class="stat"><span>One orbit</span><strong>{f.years.toFixed(2)} years</strong></div><div class="stat"><span>Distance from Sun</span><strong>{f.au.toFixed(2)} AU</strong></div></div>
<section class="section"><h2>{n} quick facts</h2><div class="table-wrap"><table class="facts-table"><tbody>{facts.map(([k,v])=><tr><th scope="row">{k}</th><td>{v}</td></tr>)}</tbody></table></div><p class="worked">Reference: <a class="text-link" href="https://nssdc.gsfc.nasa.gov/planetary/factsheet/">NASA Planetary Fact Sheet</a>. Rounded values; diameters are equatorial, area and volume use the mean radius. Moon counts include discoveries announced through 2025 (such as Uranus’s S/2025 U1) and keep growing as new moons are confirmed.</p></section>
<div class="explanation"><div><h2>{isEarth?'How big is Earth?':`How big is ${n} compared to Earth?`}</h2>{isEarth?<p>Earth is <strong>{num(p.diameter)} km</strong> ({miles(p.diameter)} miles) wide at the equator and slightly narrower pole to pole. It is the largest and densest of the rocky planets, but Jupiter is <strong>{ratio(byId('jupiter').diameter/p.diameter)} times</strong> wider and about {num(planetFacts(byId('jupiter')).volumeRatio)} Earths could fit inside it.</p>:<p>{n}’s equatorial diameter of <strong>{num(p.diameter)} km</strong> makes it <strong>{wide}</strong>. By volume, {fit}. Its mass is <strong>{ratio(f.massRatio)} times</strong> Earth’s, so its average density is {f.densityG<1?'remarkably low':'similar'}: {density}.</p>}<p>{isEarth?`The Moon, ${num(moon.diameter)} km across, is about ${Math.round(moon.diameter/p.diameter*100)}% of Earth’s width.`:`Earth’s equatorial diameter is ${num(earth.diameter)} km (${miles(earth.diameter)} miles).`} <a class="text-link" href="/planets/compare/">See every planet to scale ↗</a></p><figure class="size-figure"><Fragment set:html={figure}/><figcaption>{isEarth?'Earth and the Moon':`${n} and Earth`} drawn to the same scale (equatorial diameters).</figcaption></figure></div><aside class="note"><span class="eyebrow">One thing to remember</span><h3>{p.fact}</h3><p>Explore the atlas one planet at a time, or jump into a lab to discover the physics behind the numbers.</p></aside></div>
<div class="prose-grid"><section><h2>{isEarth?'What is the gravity on Earth?':`What is the gravity on ${n}?`}</h2><p>{isEarth?`Surface gravity on Earth averages about ${g} m/s², the reference value for “1 g”. Escape velocity is ${p.escape} km/s.`:`Gravity on ${n} is about ${g} m/s² ${where}: ${times(f.gravityRatio)} times Earth’s ${earth.gravity} m/s². Someone who weighs 100 lb on Earth would weigh about ${weight} lb on ${n}. To escape its pull, a rocket needs ${p.escape} km/s.`}</p><a class="text-link" href={`/labs/gravity-calculator/?mass=${f.massRatio.toFixed(4)}&radius=${(p.radius/earth.radius).toFixed(4)}&body=70`}>Calculate your weight on {n} ↗</a></section><section><h2>{isEarth?'How far is Earth from the Sun?':`How far is ${n} from the Sun and Earth?`}</h2><p>{n} orbits an average <strong>{num(p.distance,1)} million km</strong> ({num(f.distanceMiles,1)} million miles, {num(f.au,2)} AU) from the Sun, ranging from {num(p.perihelion,1)} to {num(p.aphelion,1)} million km. Sunlight takes {minutes(f.lightMinutes)} to get there.{!isEarth&&` Its distance from Earth varies from about ${num(f.near,1)} to ${num(f.far,1)} million km.`}</p><a class="text-link" href={`/labs/light-travel/?distance=${f.au.toFixed(4)}&unit=au`}>Time sunlight’s journey ↗</a></section><section><h2>How long is a day and a year on {n}?</h2><p>A solar day on {n} lasts <strong>{day}</strong>, and one spin relative to the stars takes {spin}. A year — one trip around the Sun at {p.speed} km/s — lasts <strong>{year}</strong>. Its axis is tilted {p.tilt}°.</p><a class="text-link" href={`/labs/orbit-simulator/?a=${f.au.toFixed(3)}&e=${p.e}&mass=1&phase=0`}>Watch the orbit ↗</a></section><section><h2>{typeQ}</h2><p>{type}</p><a class="text-link" href="/planets/">Meet all eight planets ↗</a></section></div>
<Faq title={`${n} questions, answered`} items={faq}/>
<section class="section"><h2>Explore another planet</h2><ul class="chip-grid">{planets.filter(o=>o.id!==p.id).map(o=><li><a href={`/planets/${o.id}/`}><span class="orb" style={`--planet:${o.color}`} aria-hidden="true"></span>{o.name} facts</a></li>)}<li><a href="/planets/compare/">Compare all planets ↗</a></li></ul></section></div></Layout>
