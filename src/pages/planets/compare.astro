---
import Layout from '../../layouts/Layout.astro';import Faq from '../../components/Faq.astro';import AdSlot from '../../components/AdSlot.astro';import {planets,byId,planetFacts,num,sizeDiagram} from '../../lib/planets.mjs';
const earth=byId('earth'),rows=planets.map(p=>({p,f:planetFacts(p)}));
const pick=(key:(r:any)=>number,dir=1)=>{const best=Math.max(...rows.map(r=>dir*key(r)));return rows.filter(r=>dir*key(r)===best);},names=(list:any[])=>list.map(r=>r.p.name).join(' and ');
const bySize=[...rows].sort((a,b)=>b.p.diameter-a.p.diameter),largest=bySize[0],smallest=bySize.at(-1),twin=[...rows].filter(r=>r.p.id!=='earth').sort((a,b)=>Math.abs(a.f.widthRatio-1)-Math.abs(b.f.widthRatio-1))[0],gravityTwin=[...rows].filter(r=>r.p.id!=='earth').sort((a,b)=>Math.abs(a.p.gravity-earth.gravity)-Math.abs(b.p.gravity-earth.gravity))[0];
const records=[['Which planet is the largest?',largest.p,`${num(largest.p.diameter)} km across, ${num(largest.f.widthRatio,2)}× Earth’s width. About ${num(largest.f.volumeRatio)} Earths would fit inside.`],['Which planet is the smallest?',smallest.p,`${num(smallest.p.diameter)} km across, ${num(smallest.f.widthRatio,2)}× Earth’s width — only a little larger than our Moon.`],...[[pick(r=>r.p.mass)[0],'Which planet is the most massive?',(r:any)=>`${num(r.f.massRatio,1)} Earth masses — more than twice all the other planets combined.`],[pick(r=>r.p.mass,-1)[0],'Which planet is the lightest?',(r:any)=>`${num(r.f.massRatio,3)} Earth masses. (Saturn is the least dense, but far from the lightest.)`],[pick(r=>r.p.gravity)[0],'Which planet has the strongest gravity?',(r:any)=>`${r.p.gravity} m/s² at the cloud tops, ${num(r.f.gravityRatio,2)}× Earth’s.`],[pick(r=>r.p.density,-1)[0],'Which planet is the least dense?',(r:any)=>`${r.f.densityG.toFixed(2)} g/cm³ — less dense than water.`],[pick(r=>r.p.density)[0],'Which planet is the densest?',(r:any)=>`${r.f.densityG.toFixed(2)} g/cm³, thanks to a large iron core.`],[pick(r=>r.p.temp)[0],'Which planet is the hottest?',(r:any)=>`About ${r.p.temp} °C on average — hotter than Mercury because of its thick CO₂ atmosphere.`],[pick(r=>r.p.day,-1)[0],'Which planet has the shortest day?',(r:any)=>`One solar day lasts about ${r.p.day} hours.`],[pick(r=>r.p.moons)[0],'Which planet has the most moons?',(r:any)=>`${r.p.moons} officially recognized moons (NASA, 2025).`],[pick(r=>-Math.abs(r.p.tilt-90))[0],'Which planet is tilted on its side?',(r:any)=>`Its axis is tilted ${r.p.tilt}°, so it rolls around the Sun on its side.`]].map(([r,q,text]:any)=>[q,r.p,text(r)])];
const cols=[['Diameter (km)',(r:any)=>r.p.diameter,(r:any)=>num(r.p.diameter)],['Width vs Earth',(r:any)=>r.f.widthRatio,(r:any)=>`${num(r.f.widthRatio,2)}×`],['Mass (Earths)',(r:any)=>r.f.massRatio,(r:any)=>num(r.f.massRatio,r.f.massRatio<1?3:1)],['Density (g/cm³)',(r:any)=>r.f.densityG,(r:any)=>r.f.densityG.toFixed(2)],['Gravity (m/s²)',(r:any)=>r.p.gravity,(r:any)=>r.p.gravity.toFixed(1)],['Escape velocity (km/s)',(r:any)=>r.p.escape,(r:any)=>r.p.escape],['Distance from Sun (AU)',(r:any)=>r.f.au,(r:any)=>r.f.au.toFixed(2)],['Year (Earth years)',(r:any)=>r.f.years,(r:any)=>num(r.f.years,2)],['Solar day (hours)',(r:any)=>r.p.day,(r:any)=>num(r.p.day,1)],['Known moons',(r:any)=>r.p.moons,(r:any)=>r.p.moons]] as const;
const faq=[['What is the order of the planets by size?',`From largest to smallest: ${bySize.map(r=>`${r.p.name} (${num(r.p.diameter)} km)`).join(', ')}.`],['Which planet is closest in size to Earth?',`${twin.p.name}. It is ${num(twin.p.diameter)} km across, ${num(twin.f.widthRatio,2)} times Earth’s width, which is why it is often called Earth’s twin.`],['Which planet has gravity most like Earth’s?',`${gravityTwin.p.name}, at about ${gravityTwin.p.gravity.toFixed(1)} m/s² compared with Earth’s ${earth.gravity} m/s². Venus (8.9 m/s²) is the closest match on a solid surface.`],['How many Earths can fit inside Jupiter?',`About ${num(largest.f.volumeRatio)} by volume, comparing mean radii. Jupiter is ${num(largest.f.widthRatio,2)} times wider than Earth and ${num(largest.f.massRatio)} times more massive.`],['Why does Saturn have lower gravity than its size suggests?',`Gravity depends on mass divided by radius squared. Saturn has ${num(planetFacts(byId('saturn')).massRatio)} times Earth’s mass, but its radius is about 9 times larger, so its cloud-top gravity of 9.0 m/s² is close to Earth’s.`]];
---
<Layout title="Planet Size Comparison: All 8 Planets vs Earth" description="All 8 planets compared to Earth: sizes to scale plus diameter, mass, gravity, density, distance and year length. Jupiter is 11.2× wider than Earth; Mercury 0.38×." section="Planets" crumbs={[['Planets','/planets/'],['Planet comparison']]}><div class="wrap"><div class="breadcrumb"><a href="/planets/">Planet atlas</a> / Compare the planets</div><div class="page-intro"><span class="eyebrow">Planet size comparison</span><h1>All eight planets, side by side.</h1><p class="answer"><strong>{largest.p.name}</strong> is the largest planet at {num(largest.p.diameter)} km across — {num(largest.f.widthRatio,2)} times wider than Earth. <strong>{smallest.p.name}</strong> is the smallest at {num(smallest.p.diameter)} km, {num(smallest.f.widthRatio,2)} times Earth’s width. Compare sizes, mass, gravity, density and orbits for every planet below.</p></div>
<figure class="size-figure scroll-x"><Fragment set:html={sizeDiagram(planets,{width:1240,height:330})}/><figcaption>The eight planets drawn to the same scale by equatorial diameter, in order from the Sun. Distances between them are not to scale.</figcaption></figure>
<section class="section"><div class="section-head"><div><h2>Planet data compared</h2><p>Select a column heading to sort. Rounded values from the NASA Planetary Fact Sheet; giant-planet gravity is at the 1-bar level.</p></div></div><div class="table-wrap"><table class="sortable" data-sortable><thead><tr><th scope="col" aria-sort="none"><button type="button" data-col="0">Planet</button></th>{cols.map(([label],i)=><th scope="col" aria-sort="none"><button type="button" data-col={i+1}>{label}</button></th>)}</tr></thead><tbody>{rows.map((r,i)=><tr><th scope="row" data-sort={i}><a href={`/planets/${r.p.id}/`}>{r.p.name}</a></th>{cols.map(([,value,text])=><td data-sort={value(r)}>{text(r)}</td>)}</tr>)}</tbody></table></div></section><AdSlot type="rectangle"/>
<section class="section"><h2>Your weight on every planet</h2><p>Enter the number from your bathroom scale in any unit — pounds, kilograms or stone. Each result uses the same unit. Gas and ice giants are measured at the cloud tops.</p><form class="quick-calc" data-weight><label class="field"><span class="field-name">Your weight on Earth</span><input type="number" name="weight" value="100" min="0" step="any" inputmode="decimal"/></label><ul class="weight-list">{rows.map(r=><li><a href={`/planets/${r.p.id}/`}>{r.p.name}</a><strong data-weight-out={r.f.gravityRatio}>{num(100*r.f.gravityRatio,1)}</strong></li>)}</ul><p class="status" role="status" data-status></p></form></section>
<section class="section"><h2>Planet records</h2><div class="record-grid">{records.map(([q,p,text]:any)=><div class="record"><h3>{q}</h3><p><a class="text-link" href={`/planets/${p.id}/`}>{p.name} ↗</a></p><p>{text}</p></div>)}</div></section>
<AdSlot type="native"/><Faq title="Planet comparison questions" items={faq}/>
<section class="section"><h2>Read each planet’s full facts</h2><ul class="chip-grid">{planets.map(p=><li><a href={`/planets/${p.id}/`}><span class="orb" style={`--planet:${p.color}`} aria-hidden="true"></span>{p.name} facts</a></li>)}<li><a href="/labs/gravity-calculator/">Gravity calculator ↗</a></li></ul></section></div></Layout>
<script>
document.querySelectorAll<HTMLTableElement>('[data-sortable]').forEach(table=>{const body=table.tBodies[0];table.querySelectorAll<HTMLButtonElement>('button[data-col]').forEach(button=>button.addEventListener('click',()=>{const th=button.closest('th')!,col=Number(button.dataset.col),dir=th.getAttribute('aria-sort')==='descending'?1:-1;table.querySelectorAll('th[aria-sort]').forEach(h=>h.setAttribute('aria-sort','none'));th.setAttribute('aria-sort',dir===1?'ascending':'descending');const order=col===0?1:dir;[...body.rows].sort((a,b)=>order*(Number((a.cells[col] as HTMLElement).dataset.sort)-Number((b.cells[col] as HTMLElement).dataset.sort))).forEach(row=>body.append(row));if(col===0)th.setAttribute('aria-sort','ascending');}));});
document.querySelectorAll<HTMLFormElement>('[data-weight]').forEach(form=>{const input=form.elements.namedItem('weight') as HTMLInputElement,status=form.querySelector('[data-status]')!;form.addEventListener('submit',e=>e.preventDefault());input.addEventListener('input',()=>{const w=Number(input.value);if(!input.value.trim()||!Number.isFinite(w)||w<0){status.textContent='Enter a weight of zero or more.';return;}status.textContent='';form.querySelectorAll<HTMLElement>('[data-weight-out]').forEach(el=>el.textContent=(w*Number(el.dataset.weightOut)).toLocaleString('en-US',{maximumFractionDigits:1}));});});
</script>
