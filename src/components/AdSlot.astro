---
// One Adsterra unit. Space is reserved up front so the page never jumps, and the ad script
// loads only when the slot nears the viewport on the production hostname.
// type: 'leaderboard' (728×90 desktop / 320×50 phones), 'rectangle' (300×250) or 'native'.
const {type='leaderboard'}=Astro.props;
---
<aside class={`ad-slot ad-${type}`} data-ad={type} aria-label="Advertisement"><span class="ad-label">Advertisement</span><div class="ad-unit"></div></aside>
<script>
import {ads} from '../lib/ads.mjs';
// Adsterra banner snippets read one global `atOptions`, so banners load strictly one at a time.
let queue=Promise.resolve();
const wide=()=>matchMedia('(min-width: 800px)').matches;
function fill(slot:HTMLElement){
  const box=slot.querySelector('.ad-unit') as HTMLElement;
  if(slot.dataset.ad==='native'){
    box.id=`container-${ads.native}`;
    const script=document.createElement('script');script.async=true;script.dataset.cfasync='false';script.src=`${ads.host}/21/${ads.native}`;
    box.before(script);
    return;
  }
  const [key,width,height]=slot.dataset.ad==='rectangle'?[ads.rectangle,300,250]:wide()?[ads.leaderboard,728,90]:[ads.mobile,320,50];
  queue=queue.then(()=>new Promise<void>(resolve=>{
    const options=document.createElement('script');options.text=`atOptions = ${JSON.stringify({key,format:'iframe',height,width,params:{}})};`;
    const script=document.createElement('script');script.src=`${ads.host}/22/${key}`;
    script.onload=script.onerror=()=>resolve();setTimeout(resolve,8000);
    box.append(options,script);
  }));
}
const live=location.hostname===ads.domain||location.hostname===`www.${ads.domain}`;
const slots=document.querySelectorAll<HTMLElement>('.ad-slot');
if(live&&'IntersectionObserver' in window){
  const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(!entry.isIntersecting)return;observer.unobserve(entry.target);fill(entry.target as HTMLElement);}),{rootMargin:'300px 0px'});
  slots.forEach(slot=>observer.observe(slot));
}else if(live)slots.forEach(fill);
</script>
