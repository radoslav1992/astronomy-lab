---
import {render} from '../lib/render.mjs';
const {lab}=Astro.props;const initial=render(lab.id,Object.fromEntries(lab.fields.map(f=>[f.id,f.value])));
---
<astro-lab data-lab={lab.id}>
<div class="presets" aria-label="Experiment presets">{lab.presets.map(([name,values])=><button class="btn" data-preset={JSON.stringify(values)}>{name}</button>)}</div>
<div class="lab-workspace"><div class="viz-panel"><div class="viz-header"><span>{lab.name}</span><span>Interactive model</span></div><div class="viz" set:html={initial.svg}/><div class="viz-actions">{['orbit-simulator','moon-phases','exoplanet-transit'].includes(lab.id)&&<button class="btn small" data-play aria-pressed="false">Play simulation</button>}<button class="btn small" data-reset>Reset</button><button class="btn small" data-share>Copy link</button><button class="btn small" data-download>Save diagram</button></div><div class="readouts">{initial.metrics.map(([label,value])=><div class="readout"><small>{label}</small><strong>{value}</strong></div>)}</div></div><div class="controls"><h3>Your experiment</h3><div class="fields">{lab.id==='light-travel'&&<label class="field"><span class="field-name">Distance unit</span><select data-unit><option value="au">Astronomical units (AU)</option><option value="ly">Light-years</option><option value="pc">Parsecs</option><option value="km">Kilometers</option></select></label>}{lab.id==='moon-phases'&&<label class="field"><span class="field-name">Estimate for a date <small>12:00 UTC</small></span><input type="date" data-date min="1900-01-01" max="2100-12-31"/></label>}{lab.fields.map(f=><div class="field"><label class="field-name" for={`number-${f.id}`}>{f.label} <small data-unit-label={f.id}>{f.unit}</small></label><input id={`number-${f.id}`} data-number={f.id} type="number" min={f.min} max={f.max} step="any" value={f.value}/><input type="range" data-range={f.id} min={f.min} max={f.max} step={f.step} value={f.value} aria-label={`${f.label} slider`}/></div>)}</div><p class="status" role="status" data-status></p></div></div>
<div class="worked" data-worked>{initial.worked}</div>
</astro-lab>
<noscript><p class="note">Enable JavaScript to change this experiment. The default model and explanation are available above.</p></noscript>
<script>
import {labs} from '../lib/labs.mjs';import {render} from '../lib/render.mjs';import {moonAge} from '../lib/science.mjs';
class AstroLab extends HTMLElement{
 connectedCallback(){
 const lab=labs.find(l=>l.id===this.dataset.lab);if(!lab)return;
 let values=Object.fromEntries(lab.fields.map(f=>[f.id,f.value])),unit='au',playing=false,frame=0,last=0;
 const status=this.querySelector('[data-status]') as HTMLElement;
 const tell=(s:string)=>status.textContent=s;
 const stop=()=>{playing=false;cancelAnimationFrame(frame);const b=this.querySelector('[data-play]');if(b){b.textContent='Play simulation';b.setAttribute('aria-pressed','false');}};
 const sync=()=>{lab.fields.forEach(f=>{(this.querySelector(`[data-number="${f.id}"]`) as HTMLInputElement).value=String(values[f.id]);(this.querySelector(`[data-range="${f.id}"]`) as HTMLInputElement).value=String(values[f.id]);});};
 const draw=()=>{const r=render(lab.id,values,unit);this.querySelector('.viz')!.innerHTML=r.svg;const readouts=this.querySelector('.readouts')!;readouts.replaceChildren(...r.metrics.map(([label,value])=>{const div=document.createElement('div');div.className='readout';const small=document.createElement('small'),strong=document.createElement('strong');small.textContent=label;strong.textContent=value;div.append(small,strong);return div;}));this.querySelector('[data-worked]')!.textContent=r.worked;};
 const params=new URLSearchParams(location.search);let invalid=false;
 lab.fields.forEach(f=>{if(params.has(f.id)){const raw=params.get(f.id)!,n=Number(raw);if(raw.trim()&&Number.isFinite(n)&&n>=f.min&&n<=f.max)values[f.id]=n;else invalid=true;}});
 if(lab.id==='light-travel'&&params.has('unit')){if(['au','ly','pc','km'].includes(params.get('unit')!))unit=params.get('unit')!;else invalid=true;}
 const unitEl=this.querySelector('[data-unit]') as HTMLSelectElement|null;if(unitEl){unitEl.value=unit;(this.querySelector('[data-unit-label="distance"]') as HTMLElement).textContent=unit;unitEl.addEventListener('change',()=>{unit=unitEl.value;(this.querySelector('[data-unit-label="distance"]') as HTMLElement).textContent=unit;draw();tell('Distance unit changed; the numerical value is unchanged.');});}
 sync();draw();if(invalid)tell('Some link values were outside this lab’s limits; defaults were used.');
 this.querySelectorAll<HTMLInputElement>('[data-number],[data-range]').forEach(input=>input.addEventListener('input',()=>{stop();const id=input.dataset.number||input.dataset.range!,f=lab.fields.find(f=>f.id===id)!;const raw=input.value,n=Number(raw);if(!raw.trim()||!Number.isFinite(n)||n<f.min||n>f.max){input.setAttribute('aria-invalid','true');tell(`Enter ${f.label.toLowerCase()} between ${f.min} and ${f.max}. The diagram keeps the last valid value.`);return;}input.removeAttribute('aria-invalid');values[id]=n;const other=this.querySelector(input.dataset.number?`[data-range="${id}"]`:`[data-number="${id}"]`) as HTMLInputElement;other.value=raw;other.removeAttribute('aria-invalid');if(lab.id==='moon-phases')(this.querySelector('[data-date]') as HTMLInputElement).value='';tell('');draw();}));
 this.querySelectorAll<HTMLButtonElement>('[data-preset]').forEach(b=>b.addEventListener('click',()=>{stop();values={...values,...JSON.parse(b.dataset.preset!)};if(unitEl){unit='au';unitEl.value=unit;(this.querySelector('[data-unit-label="distance"]') as HTMLElement).textContent=unit;}this.querySelectorAll('[aria-invalid]').forEach(el=>el.removeAttribute('aria-invalid'));const d=this.querySelector('[data-date]') as HTMLInputElement;if(d)d.value='';sync();draw();tell(`${b.textContent} preset loaded.`);}));
 this.querySelector('[data-reset]')!.addEventListener('click',()=>{stop();values=Object.fromEntries(lab.fields.map(f=>[f.id,f.value]));unit='au';if(unitEl){unitEl.value=unit;(this.querySelector('[data-unit-label="distance"]') as HTMLElement).textContent=unit;}const d=this.querySelector('[data-date]') as HTMLInputElement;if(d)d.value='';this.querySelectorAll('[aria-invalid]').forEach(el=>el.removeAttribute('aria-invalid'));sync();draw();tell('Experiment reset.');});
 const date=this.querySelector('[data-date]') as HTMLInputElement|null;date?.addEventListener('change',()=>{if(!date.value||!date.checkValidity()){tell('Choose a date between 1900 and 2100.');return;}stop();values.age=moonAge(date.value+'T12:00:00Z');sync();draw();tell('Approximate phase at noon UTC; not an exact observing forecast.');});
 this.querySelector('[data-share]')!.addEventListener('click',async()=>{const url=new URL(location.href);url.search='';Object.entries(values).forEach(([key,value])=>url.searchParams.set(key,String(value)));if(unitEl)url.searchParams.set('unit',unit);try{await navigator.clipboard.writeText(url.href);tell('Link copied with your experiment settings.');}catch{tell('Copy this link from the address bar.');history.replaceState(null,'',url);}});
 this.querySelector('[data-download]')!.addEventListener('click',()=>{const markup=render(lab.id,values,unit).svg.replace('<svg ','<svg style="background:#060c18" ').replace('<defs>','<style>text{font:14px sans-serif;fill:#c2d3e6}</style><defs>');const url=URL.createObjectURL(new Blob([markup],{type:'image/svg+xml'}));const a=document.createElement('a');a.href=url;a.download=lab.id+'.svg';a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);tell('Diagram saved as an SVG image.');});
 const tick=(now:number)=>{if(!playing)return;const dt=Math.min((now-last)/1000,.1);last=now;const key=lab.id==='orbit-simulator'?'phase':lab.id==='moon-phases'?'age':'position';const min=lab.id==='exoplanet-transit'?-150:0,max=key==='phase'?100:key==='age'?29.53:150;values[key]=min+((values[key]-min+dt*(max-min)/15)%(max-min));sync();draw();frame=requestAnimationFrame(tick);};
 this.querySelector('[data-play]')?.addEventListener('click',()=>{if(playing){stop();return;}playing=true;last=performance.now();const b=this.querySelector('[data-play]')!;b.textContent='Pause simulation';b.setAttribute('aria-pressed','true');frame=requestAnimationFrame(tick);});
 document.addEventListener('visibilitychange',()=>{if(document.hidden)stop();});window.addEventListener('pagehide',stop,{once:true});
 }
}
customElements.define('astro-lab',AstroLab);
</script>
